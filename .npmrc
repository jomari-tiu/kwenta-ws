# Build tools live in devDependencies: typescript, @types/*, drizzle-kit.
# Render sets NODE_ENV=production, which makes npm skip devDependencies — so
# `npm run build` fails with "Could not find a declaration file for module
# 'express'" and, before that, resolves a different tsc entirely.
#
# Render runs the build and the app from ONE install, so including dev here
# costs nothing at runtime and removes a deploy setting that is easy to get
# wrong. Drop this line only if the build stops needing devDependencies.
#
# Never put an auth token in this file — it is committed.
include=dev
