# ---- App ----
NODE_ENV=development
PORT=8000
TZ=Asia/Manila
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=debug

# ---- Database ----
# Local Docker Postgres (see README): docker compose up -d
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financial_tracker_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# ---- Auth ----
# Must be >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me-at-least-32-characters-long
JWT_TTL=604800

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=

# ---- Owner bootstrap (used once by db:seed) ----
OWNER_EMAIL=owner@example.com
OWNER_NAME=Owner
OWNER_PASSWORD=change-me-locally

# ---- Recurring materialization ----
RECURRING_CATCHUP_ENABLED=true
RECURRING_CATCHUP_MIN_INTERVAL_SEC=60
